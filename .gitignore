# ⛔ Ignorer les dépendances installées (si Conda ou pip est utilisé)
requirements.txt.lock

# ⛔ Ignorer les fichiers spécifiques à VS Code
.vscode/

# ⛔ Ignorer les résultats générés (images traitées, nuages de points)
results/
images/
